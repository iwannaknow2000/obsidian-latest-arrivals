{
  "name": "obsidian-latest-arrivals",
  "version": "1.2.0",
  "description": "「最新入库」— 找出通过 Syncthing 等第三方同步工具最新到达本机的 Obsidian 笔记。",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "pretest": "npm run build",
    "test": "npm run test:unit && npm run test:smoke",
    "test:unit": "esbuild test/run.ts --bundle --platform=node --format=esm --target=node18 --outfile=test/.build/run.mjs --log-level=warning && node test/.build/run.mjs",
    "test:smoke": "node test/smoke.cjs",
    "deploy": "node scripts/deploy.mjs",
    "publish:gh": "node scripts/publish.mjs",
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs --dry-run",
    "lint": "eslint src"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "syncthing",
    "mobile"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.24.2",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.8.7",
    "typescript": "^5.7.2"
  },
  "author": "iwannaknow2000",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iwannaknow2000/obsidian-latest-arrivals.git"
  }
}
